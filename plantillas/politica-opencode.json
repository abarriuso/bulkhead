{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/usr/local/share/entorno-ia/ENTORNO.md",
    "/workspace/AGENTS.md",
    "/workspace/CLAUDE.md"
  ],
  "default_agent": "build",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    },
    "webfetch": "ask",
    "external_directory": {
      "*": "deny",
      "/tmp/opencode/*": "allow"
    },
    "task": {
      "*": "deny",
      "general": "allow",
      "explore": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": "ask",
        "bash": {
          "*": "ask",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "webfetch": "ask",
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/*": "allow"
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": "deny",
        "bash": {
          "*": "ask",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "webfetch": "ask",
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/*": "allow"
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow"
        }
      }
    },
    "explore": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
